<h1>Add Coffee Shop</h1>

<form action="/add-poi" method="POST">

  <label>Name</label>
  <input type="text" name="name" required>

  <label>Description</label>
  <textarea name="description" required></textarea>

  <label>Category</label>
  <select name="category" required>
    <option value="">Select Category</option>

    <option value="Cafe">Cafe</option>

    <option value="Roastery">Roastery</option>

    <option value="Bakery">Bakery</option>

    <option value="Drive-Thru">Drive-Thru</option>

    <option value="Coffee Cart">Coffee Cart</option>

    <option value="Coffee Van">Coffee Van</option>
  </select>

  <label>Latitude</label>
  <input type="number" step="any" name="lat" required>

  <label>Longitude</label>
  <input type="number" step="any" name="lng" required>

  <button type="submit">Add POI</button>
</form>

