<h1>Welcome to Placemark Coffee</h1>

<h2>Add a Coffee Shop</h2>
<a href="/add-poi">Add POI</a>

<h2>All Coffee Shops</h2>

<ul>
  {{#each pois}}
    <li>{{this.name}}</li>
  {{/each}}
</ul>

<h1>Your Coffee Shops</h1>

{{#each pois}}
  <div class="poi-card">
    <h2>{{name}}</h2>
    <p>{{description}}</p>
    <p>Category: {{category}}</p>
    <p>Location: {{lat}}, {{lng}}</p>

    <a href="/poi/{{id}}/edit">Edit</a>
    <a href="/poi/{{id}}/delete">Delete</a>
  </div>
{{/each}}
