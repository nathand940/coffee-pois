<h1>Admin Dashboard</h1>

<h2>Analytics</h2>

<ul>
  <li><strong>Total Users:</strong> {{totalUsers}}</li>
  <li><strong>Admin Users:</strong> {{adminUsers}}</li>
  <li><strong>Total POIs:</strong> {{totalPois}}</li>
  <li><strong>Categories Used:</strong> {{totalCategories}}</li>
</ul>

<hr>

<h2>Registered Users</h2>

<ul>
  {{#each users}}

    <li>

      {{name}} ({{email}})
      - {{role}}

      <a href="/admin/delete-user/{{_id}}">
        Delete
      </a>

    </li>

  {{/each}}
</ul>