<h1>User Settings</h1>

<form action="/settings" method="POST">

  <label>Name</label>
  <input type="text" name="firstName" value="{{user.name}}" required>

  <label>Email</label>
  <input type="email" name="email" value="{{user.email}}" required>

  <button type="submit">Save Changes</button>

</form>
